rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: essays
    // Document ID: auto-generated
    // Fields:
    //   - nombreEstudiante: string (required, 1-100 chars)
    //   - grado: string (required, 1-20 chars)
    //   - tituloEnsayo: string (required, 1-200 chars)
    //   - ensayoOriginal: string (required, 1-10000 chars)
    //   - fecha: string (required, format D/M/AA)
    //   - puntuacion: number (required, 0-100)
    //   - mensajeMotivacion: string (optional, 1-2000 chars)
    //   - observacionesDetalladas: list (optional, max 50 items)
    //   - resumenCategorias: list (optional, max 10 items)
    //   - uid: string (required, matches auth.uid)
    //   - createdAt: timestamp (required, server-assigned)
    //
    // Collection: test
    // Document ID: connection
    // Fields: any
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      // List.hasOnly() is not supported, use size equality with hasAll
      return request.resource.data.keys().hasAll(fields) && 
             request.resource.data.keys().size() == fields.size();
    }

    function isVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isValidString(field, min, max) {
      return request.resource.data[field] is string && 
             request.resource.data[field].size() >= min && 
             request.resource.data[field].size() <= max;
    }

    function isValidOptionalString(field, max) {
      return !(field in request.resource.data) || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    function isValidList(field, maxCount) {
      return !(field in request.resource.data) || (request.resource.data[field] is list && request.resource.data[field].size() <= maxCount);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidEssay(data) {
      let requiredFields = [
        'nombreEstudiante', 'grado', 'tituloEnsayo', 'ensayoOriginal', 
        'transcripcionExacta', 'fecha', 'puntuacion', 'uid', 'createdAt',
        'desglose', 'recomendaciones', 'nivelEnsayo', 'observacionesDetalladas', 'resumenCategorias'
      ];
      
      return hasRequiredFields(requiredFields) &&
             hasOnlyAllowedFields(requiredFields) &&
             isValidString('nombreEstudiante', 1, 100) &&
             isValidString('grado', 1, 20) &&
             isValidString('tituloEnsayo', 1, 256) &&
             isValidString('ensayoOriginal', 0, 10000) &&
             isValidString('transcripcionExacta', 1, 10000) &&
             isValidString('fecha', 1, 32) &&
             data.puntuacion is number && data.puntuacion >= 0 && data.puntuacion <= 5 &&
             data.desglose is map &&
             data.desglose.tesis is number && data.desglose.tesis >= 0 && data.desglose.tesis <= 5 &&
             data.desglose.argumentacion is number && data.desglose.argumentacion >= 0 && data.desglose.argumentacion <= 5 &&
             data.desglose.coherencia is number && data.desglose.coherencia >= 0 && data.desglose.coherencia <= 5 &&
             data.desglose.estructura is number && data.desglose.estructura >= 0 && data.desglose.estructura <= 5 &&
             data.desglose.ortografia is number && data.desglose.ortografia >= 0 && data.desglose.ortografia <= 5 &&
             data.desglose.pensamientoCritico is number && data.desglose.pensamientoCritico >= 0 && data.desglose.pensamientoCritico <= 5 &&
             isValidString('recomendaciones', 1, 5000) &&
             isValidString('nivelEnsayo', 1, 100) &&
             data.uid == request.auth.uid &&
             data.createdAt == request.time &&
             isValidList('observacionesDetalladas', 100) &&
             isValidList('resumenCategorias', 20);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /essays/{essayId} {
      // Users can only read their own evaluations
      allow read: if isDocOwner();
      
      // Users can create their own evaluations
      allow create: if isVerified() && isValidEssay(request.resource.data);
      
      // Evaluations are immutable once created
      allow update, delete: if false;
    }

    match /test/connection {
      allow read: if true; // Allow public read for connection test
    }
  }
}
