{
  "entities": {
    "EssayEvaluation": {
      "title": "EssayEvaluation",
      "description": "Stores the evaluation results of a student essay.",
      "type": "object",
      "properties": {
        "nombreEstudiante": { "type": "string" },
        "grado": { "type": "string" },
        "tituloEnsayo": { "type": "string" },
        "ensayoOriginal": { "type": "string" },
        "transcripcionExacta": { "type": "string" },
        "fecha": { "type": "string" },
        "puntuacion": { "type": "number" },
        "desempeñoGlobal": { "type": "string" },
        "justificacionGlobal": { "type": "string" },
        "desglose": {
          "type": "object",
          "properties": {
            "tesis": { "$ref": "#/definitions/ScoreDimension" },
            "argumentacion": { "$ref": "#/definitions/ScoreDimension" },
            "coherencia": { "$ref": "#/definitions/ScoreDimension" },
            "estructura": { "$ref": "#/definitions/ScoreDimension" },
            "ortografia": { "$ref": "#/definitions/ScoreDimension" }
          }
        },
        "analisisCriterios": {
          "type": "object",
          "properties": {
            "ortografia_letras": { "$ref": "#/definitions/CriterionAnalysis" },
            "puntuacion": { "$ref": "#/definitions/CriterionAnalysis" },
            "estructura": { "$ref": "#/definitions/CriterionAnalysis" },
            "conectores": { "$ref": "#/definitions/CriterionAnalysis" },
            "claridad": { "$ref": "#/definitions/CriterionAnalysis" },
            "sustentacion": { "$ref": "#/definitions/CriterionAnalysis" }
          }
        },
        "recomendaciones": { "type": "string" },
        "nivelEnsayo": { "type": "string" },
        "uid": { "type": "string" },
        "imagePreview": { "type": "string" },
        "observacionesDetalladas": { "type": "array" },
        "resumenCategorias": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/essays/{essayId}": {
      "schema": "EssayEvaluation",
      "description": "Collection of essay evaluations."
    }
  }
}
